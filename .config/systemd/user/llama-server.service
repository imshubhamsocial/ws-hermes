[Unit]
Description=Llama Server Daemon (Google Gemma 4 Exact 128K TurboQuant + MTP on Port 8138)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/llama-server
Restart=always
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=process
LimitNOFILE=65535

[Install]
WantedBy=default.target
