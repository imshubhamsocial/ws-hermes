# ========================================================
# Hermes Agent OS - Canonical Workspace .gitignore
# ========================================================

# User desktop, temporary files, and external GDR releases
Desktop/**
tmp/**

# Build artifacts & Python caches
build/**
dist/**
*.egg-info/**
**/*.egg-info/**
__pycache__/**
**/__pycache__/**
*.py[cod]
*$py.class
.pytest_cache/**
**/.pytest_cache/**
.ruff_cache/**
**/.ruff_cache/**
.venv/**
venv/**
env/**

# Heavy binary archives and model weights (Hard GitHub 100MB Limit)
*.tar.gz
**/*.tar.gz
*.zip
*.tar
*.gguf
**/*.gguf
pre_factory_hermes_backup.tar.gz

# Node.js dependencies
node_modules/**
**/node_modules/**
.npm/**
.npmrc

# Upstream submodule substrate purity (Rule 9)
.hermes/hermes-agent/**

# Runtime caches, databases, journals, locks, and logs
*.log
**/*.log
*.lock
**/*.lock
*.pid
*.sock
*.sqlite*
**/*.sqlite*
*.db-shm
*.db-wal
**/*.db-shm
**/*.db-wal

# Ephemeral runtime states in .hermes
.hermes/run/**
.hermes/cache/**
.hermes/audio_cache/**
.hermes/image_cache/**
.hermes/images/**
.hermes/pastes/**
.hermes/backups/**
.hermes/sandboxes/**
.hermes/runtime/**
.hermes/desktop/**
.hermes/spawn-trees/**
.hermes/terminal-sessions/**
.hermes/openviking/**
.hermes/logs/**
.hermes/sessions/**
.hermes/pairing/**
.hermes/hooks/**
.hermes/lsp/**
.hermes/bin/**
.hermes/models/**
.hermes/installs/**
.hermes/state-snapshots/**
.hermes/tui-pending-inputs/**
.hermes/decisions/**
.hermes/session-exports/**
.hermes/pending/**
.hermes/pending_messages/**
.hermes/platforms/**
.hermes/plugin-update-checks/**
.hermes/source-checks/**
.hermes/telemetry/**
.hermes/*.db*
.hermes/*_cache*
.hermes/.hermes_history
.hermes/gateway.*
.hermes/spawn-ledger.json
.hermes/.hermes-update-*
.hermes/processes.json*
.hermes/channel_directory.json
.hermes/.curator_backups/**
.hermes/jev-curator/**
.hermes/kanban/**
.hermes/plugins/**
.hermes/state/**
.hermes/.env*
.hermes/.update_check
.hermes/.backup.lock
.hermes/.env.lock
.hermes/.install_id.lock
.hermes/.mcp-discovery.lock
.hermes/.skills_prompt_snapshot.json
.hermes/install_id
.hermes/mcp_openjev.py.bak
.hermes/ollama_cloud_models_cache.json
.hermes/provider_models_cache.json*
.hermes/models_dev_cache.*
.hermes/projects.db
.hermes/shared-state.db
.hermes/state.db*
.hermes/response_store.db*
.hermes/runs_idempotency.db*
.hermes/kanban.db*

# Chezmoi archive & temporary user environment
.chezmoiignore
.local/share/chezmoi/**
.local_archived/**
.cache/**
.gemini/**
.crawl4ai/**
.cua-driver/**
.mem0/**
.dspy_cache/**
.pki/**
.nv/**
.bash_history
.bash_logout
.bash_profile
.bashrc
.distroboxrc
.profile
.zshrc
.gitconfig
.git-credentials

# Ignore other local binaries, but keep hermes-managed services and scripts
.local/bin/*
!.local/bin/llama-server
!.local/bin/openviking-server
.local/lib/**
.local/share/**
.local/state/**

# Config ignores
.config/*
!.config/systemd
.config/systemd/*
!.config/systemd/user
.config/systemd/user/*
!.config/systemd/user/hermes-llama-server.service
!.config/systemd/user/hermes-openviking.service

# User system artifacts
.cua-driver
.cua-driver/**
.rustup/**
.ssh/**
.ua/**
tests/.hermes/**

# OpenViking data directories
.openviking/*
!.openviking/ov.conf
!.openviking/ovcli.conf

# Local CUDA and build headers
.local/include/**
.local/nvvm/**
.local/nvvm

# Hermes cron runtime state & memories telemetry
.hermes/cron/catch_up_occurrences
.hermes/cron/output/**
.hermes/cron/usage_audit.jsonl
.hermes/cron/*.db*
.hermes/cron/ticker*
.hermes/memories/*.jsonl
.hermes/memories/*.lock*
.hermes/gateway_state.json
.hermes/hermes_rsi_daemon.py
.hermes/hermes-agent
.hermes/hermes-agent/**

# Hermes profiles and tool binaries
.hermes/profiles/**
.hermes/tools/**
.hermes/tui-theme-boot.json

# Hermes dynamic auto rules & skills cache
.hermes/rules/auto_rsi_*.md
.hermes/skills/.hub/**
.hermes/skills/.curator_*
.hermes/skills/.bundled_manifest
.hermes/skills/.usage.json*
.hermes/skills/**/assets/**
.hermes/skills/**/resources/**
